@echo off
REM ============================================
REM SDS BareMetal Configuration - AutoHotKey Runner
REM Generated by Ansible - DO NOT EDIT MANUALLY
REM Total Servers: {{ servers | length }}
REM ============================================

setlocal EnableDelayedExpansion

REM Configuration
set "AHK_EXE={{ ahk_exe_path }}"
set "SCRIPT_DIR={{ windows_script_dir }}"
set "WAIT_BETWEEN_NODES={{ wait_between_nodes }}"
set "WAIT_AFTER_PASSWORD={{ wait_after_password }}"
set "WAIT_AFTER_SETTINGS={{ wait_after_settings }}"

echo ============================================
echo SDS BareMetal Configuration Automation
echo Total Servers to Configure: {{ servers | length }}
echo ============================================
echo.
echo IMPORTANT: Do NOT move the mouse or press any keys during execution!
echo.
echo Press any key to start configuration...
pause >nul

REM Kill any existing AutoHotKey instances
echo.
echo Killing any existing AutoHotKey processes...
taskkill /F /IM AutoHotkeyU64.exe >nul 2>&1

{% for server in servers %}
echo.
echo ============================================
echo Configuring Node {{ loop.index }}: {{ server.hostname }}
echo iLO Host: {{ server.host }}
echo ============================================

REM Step 1: Setup Password for Node {{ loop.index }}
echo [{{ loop.index }}/{{ servers | length }}] Step 1: Setting up password for {{ server.hostname }}...
"%AHK_EXE%" "%SCRIPT_DIR%\setup_password_{{ loop.index }}.ahk"
timeout /t %WAIT_AFTER_PASSWORD% /nobreak >nul

REM Kill AutoHotKey after password setup
taskkill /F /IM AutoHotkeyU64.exe >nul 2>&1
timeout /t 5 /nobreak >nul

REM Step 2: Configure Settings for Node {{ loop.index }}
echo [{{ loop.index }}/{{ servers | length }}] Step 2: Configuring settings for {{ server.hostname }}...
"%AHK_EXE%" "%SCRIPT_DIR%\set_setting_{{ loop.index }}.ahk"
timeout /t %WAIT_AFTER_SETTINGS% /nobreak >nul

REM Kill AutoHotKey after settings
taskkill /F /IM AutoHotkeyU64.exe >nul 2>&1

echo [{{ loop.index }}/{{ servers | length }}] Completed configuration for {{ server.hostname }}
{% if not loop.last %}

echo.
echo Waiting %WAIT_BETWEEN_NODES% seconds before next node...
timeout /t %WAIT_BETWEEN_NODES% /nobreak >nul
{% endif %}

{% endfor %}

echo.
echo ============================================
echo All {{ servers | length }} nodes configured successfully!
echo ============================================
echo.
pause
